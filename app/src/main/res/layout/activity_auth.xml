<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/paper" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/back" android:layout_width="44dp" android:layout_height="44dp"
            android:gravity="center" android:text="‹" android:textColor="@color/ink"
            android:textSize="30sp" android:background="@drawable/bg_panel" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="登录 / 注册" android:textColor="@color/ink"
            android:textSize="25sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:text="连接 Workspace 账号" android:textColor="@color/muted"
            android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="horizontal">
            <TextView android:id="@+id/tab_login" android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:gravity="center" android:text="登录"
                android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/tab_register" android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:gravity="center" android:text="注册"
                android:textColor="@color/muted" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <EditText android:id="@+id/field_username" android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="18dp" android:background="@drawable/bg_panel"
            android:hint="用户名（3-16 位中文/字母/数字/下划线）" android:inputType="text" android:maxLength="16"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/ink"
            android:textColorHint="@color/muted" android:textSize="14sp" />
        <EditText android:id="@+id/field_email" android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="12dp" android:background="@drawable/bg_panel"
            android:hint="邮箱（接收验证码）" android:inputType="textEmailAddress"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/ink"
            android:textColorHint="@color/muted" android:textSize="14sp" android:visibility="gone" />
        <EditText android:id="@+id/field_code" android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="12dp" android:background="@drawable/bg_panel"
            android:hint="邮箱验证码（6 位）" android:inputType="number" android:maxLength="6"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/ink"
            android:textColorHint="@color/muted" android:textSize="14sp" android:visibility="gone" />
        <EditText android:id="@+id/field_password" android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="12dp" android:background="@drawable/bg_panel"
            android:hint="密码（至少 6 位）" android:inputType="textPassword"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/ink"
            android:textColorHint="@color/muted" android:textSize="14sp" />
        <TextView android:id="@+id/btn_send_code" android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="12dp" android:gravity="center" android:text="发送验证码"
            android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold"
            android:background="@drawable/bg_soft" android:visibility="gone" />
        <TextView android:id="@+id/auth_submit" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="24dp" android:gravity="center" android:text="登录"
            android:textColor="@color/surface" android:textSize="14sp" android:textStyle="bold"
            android:background="@drawable/bg_accent" />
        <TextView android:id="@+id/auth_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center"
            android:textColor="@color/muted" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>
</ScrollView>